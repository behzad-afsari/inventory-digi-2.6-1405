<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>انبار دیجی کالا</title>
    <link href="style.css" rel="stylesheet" type="text/css" />
    <style>
      #sub-groups-list ul li {
        list-style: none;
        margin: 5px;
        padding: 5px;
        float: right;
      }
      #sub-groups-list ul li a{
        padding: 5px;
        border-radius: 3px;
        background-color: rgb(226, 226, 226);
        color: black;
        min-width: 300px;
        text-decoration: none;
        padding: 5px 20px 5px;
        font-size: 15px;
      }
    </style>
  </head>

  <body>
    <%- include('menu') %>
    <div id="body">
      <div id="sub-groups-list">
        <ul>
          <li><a href="/get-all-products-subgroupe-best-selling?subgroupe=all" style="background-color: red; color: white"> همه محصولات </a></li>
          <% subGroups.map( (item) =>{ %>
            <li><a href="/get-all-products-subgroupe-best-selling?subgroupe=<%= item %>"> <%= item %> </a></li> <%})%>
          </ul>
        </div>
      </div>
    </body>
    </html>
    