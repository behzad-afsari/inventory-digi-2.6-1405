    <!-- <h3 style="direction: ltr;">تاریخ : <span class="invoice-head"><%= invoiceDetail.date %></span> نوع فاکتور: <span class="invoice-head"> <%= invoiceDetail.type %></span> مشتری:  <span class="invoice-head"><%= invoiceDetail.client %></span> تعداد کالا:  <span class="invoice-head"><%= invoiceDetail.count %></span> جمع فاکتور: <span class="invoice-head"><%= invoiceDetail.sumInvoice %></span>   <span class="invoice-head"><%= invoiceDetail.invoiceName %></span></h3> -->
    <!-- <h3 style="direction: ltr;"> <%= invoiceDetail.invoiceName %>  -   تاریخ : <%= invoiceDetail.date %>  -   نوع فاکتور:  <%= invoiceDetail.type %>  -  مشتری:  <%= invoiceDetail.client %>  -  تعداد کالا:  <%= invoiceDetail.count %>  -  جمع فاکتور: <%= invoiceDetail.sumInvoice %> </h3> -->
<h3 style="direction: ltr;"><%= invoiceDetail.invoiceName %></h3>
<h3> <span id="title">تعداد کالا: <%= invoiceDetail.count %>   </span>  <span id="title"> جمع فاکتور: <span id="sum-invoice"><%= invoiceDetail.sumInvoice %></span></span></h3>
        <table class="tb">
            <tr>
                <th>ردیف</th>
                <th>نام کالا</th>
                <th>کد تنوع</th>
                <th>تعداد</th>
                <th>قیمت</th>
                <th>کد هلو</th>
            </tr>
            <% invoiceDetail.invoice.map((item)=>{%>
                <tr>
                    <td><%= r+=1 %></td>
                    <td><%= item.name %></td>
                    <td><%= item.dkpc %></td>
                    <td><%= item.count %></td>
                    <td><%= item.price %></td>
                    <td><%= item.holoo %></td>
                </tr>
            <% }) %>
                </table>
            </div>
        </div>
        <script src="show-invoice.js"></script>
    </body>

