<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>انبار دیجی کالا</title>

    <style>
        /* body {direction: rtl; text-align: right; }
        .tb { border-collapse: collapse; width:800px; }
        .tb th, .tb td { padding: 5px; border: solid 1px #777; }
        .tb th { background-color: lightblue; } */
        #table{
            margin: 0 10px 0 0;
        }
      </style>
      <link href="style.css" rel="stylesheet" type="text/css">
</head>

<body>
    <%r=0%>
    <%less=0%>
    <%more=0%>
    <%notActive=0%>
    <%notBuyBox=0%>
    <%lessThanMinPriceNotActive=0%>
    <%lessThanMinPriceActive=0%>
    <div id="table">
    <%- include('menu') %>
        <div class="tableFixHead">
            <!-- <h1>لیست محصولات انبار</h1> -->
            <table class="tb">
                <tr>
                    <th>ردیف</th>
                    <!-- <th>گروه اصلی</th> -->
                    <th>گروه فرعی</th>
                    <th>نام کالا</th>
                    <th>dkp</th>
                    <th>dkpc</th>
                    <th>کد هلو</th>
                    <!-- <th>ابتدای دوره</th> -->
                    <th> تعداد خرید</th>
                    <th> قیمت خرید هلو</th>
                    <th> قیمت خرید لیست</th>
                    <!-- <th> برگشت از خرید</th> -->
                    <th> تعداد فروش </th>
                    <th> قیمت فروش</th>
                    <!-- <th> حداقل قیمت</th> -->
                    <!-- <th> هزینه کل</th> -->
                    <th> قیمت تمام شده</th>
                    <th> قیمت تمام شده لیست</th>

                    <th> قیمت مرحع</th>
                    <!-- <th> هزینه دیجی</th>
                    <th> سود دیجی </th>
                    <th> سود </th>
                    <th> % </th> -->
                    <!-- <th> برگشت از فروش</th> -->
                    <!-- <th> فروش حضوری</th> -->
                    <!-- <th>معدوم</th> -->
                    <th>انبار</th>
                    <th>فعال</th>
                    <th>دیجی</th>
                    <!-- <th>قابل فروش </th> -->
                    <th>اختلاف</th>
                    <!-- <th>بای باکس</th> -->
                    <!-- <th>ک‌هـ</th> -->
                    <th>توضیحات</th>

                </tr>
                <% products.map((item)=>{%>
                    <% if(item["subGroupe"] === subGRP.subgroupe || subGRP.subgroupe==="all") { %>
                    <tr>
                        <td><%= r+=1 %></td>
                        <!-- <td><%= item.mainGroupe %></td> -->
                        <td><%= item.subGroupe %></td>
                        <td style="text-align: right;"><%= item.productName %></td>
                        <!-- <td style="text-align: right;"><a href="https://seller.digikala.com/pwa/variant-management?filterSearchIn=search_term&filterSearchQuery=<%= item.dkpc %>"><%= item.productName %></a></td> -->
                        <td><a href="https://seller.digikala.com/pwa/variant-management?filterSearchIn=search_term&filterSearchQuery=<%= item.dkpc %>"><%= item.dkp %></a></td>
                        <td><a href="/dkpc-detail?dkpc=<%= item.dkpc %>"><%= item.dkpc %> </a></td>
                        <td><%= item.holoo %></td>
                        <!-- <td><%= item.beginningCount %></td> -->
                        <td style="background-color: rgb(212, 234, 255);"><%= item.sumBuy.toLocaleString() %></td>
                        <td style="background-color: rgb(212, 234, 255);"><%= Math.ceil(item.lastBuyPrice).toLocaleString() %></td>
                        <td style="background-color: rgb(212, 234, 255);"><%= Math.ceil(item.buy_price_list).toLocaleString() %></td>
                        <!-- <td><%= item.sumBackBuy %></td> -->
                        <td style="background-color: rgb(255, 212, 212);"><%= item.sumsale.toLocaleString() %></td>
                        
                        
                        <% if (item.salePrice < item.minSalePrice ){%>
                            <% if (item.active || item.stock > 0) { %>
                                <%lessThanMinPriceActive++%>
                                <td style="background-color: rgb(255, 0, 0); color:white; font-weight: 800;"><%= item.salePrice.toLocaleString() %></td>
                            <% } else { %>
                                <%lessThanMinPriceNotActive++%>
                                <td style="background-color: rgb(255, 212, 212);"><%= item.salePrice.toLocaleString() %></td>
                            <% } %>
                        <% } else {%>
                            <td style="background-color: rgb(255, 212, 212);"><%= item.salePrice.toLocaleString() %></td>
                        <% } %>



                        <!-- <td style="background-color: rgb(129, 95, 255);"><%= (Math.ceil(item.lastBuyPrice)+((Math.ceil(item.lastBuyPrice)*40)/100)).toLocaleString() %></td> -->
                        <!-- <td style="background-color: rgb(234, 152, 255);"><%= (item.lastBuyPrice + item.fulfilment_and_delivery_cost + ((item.salePrice*10)/100)).toLocaleString() %></td> -->
                        <!-- <td style="background-color: rgb(243, 197, 255);"><%= item.totalCost ? item.totalCost.toLocaleString() : 0 %></td> -->
                        <!-- <td style="background-color: rgb(234, 152, 255);"><%= parseInt(item.minSalePrice).toLocaleString() %></td> -->
                        
                        <!-- <td style="background-color: rgb(234, 152, 255);"><%= parseInt(item.lastBuyPrice+(item.lastBuyPrice*50)/100).toLocaleString() %></td>
                        <td style="background-color: rgb(234, 152, 255);"><%= parseInt(item.buy_price_list+(item.buy_price_list*50)/100).toLocaleString() %></td> -->

                        <!-- <td style="background-color: rgb(152, 134, 255);"><%= item.lastBuyPrice ? parseInt(item.lastBuyPrice + item.processing_fee + ((item.salePrice * item.digip_profit_percentage)/100) + ((((item.salePrice * item.digip_profit_percentage)/100) + item.processing_fee)*0.1)).toLocaleString() : 0 %></td> 
                        <td style="background-color: rgb(152, 134, 255);"><%= item.buy_price_list ? parseInt(  item.buy_price_list + item.processing_fee + ((item.salePrice * item.digip_profit_percentage)/100)  +  ((((item.salePrice * item.digip_profit_percentage)/100) + item.processing_fee)*0.1) ).toLocaleString() : 0 %></td>  -->
                        <td style="background-color: rgb(152, 134, 255);"><%= item.lastBuyPrice ? parseInt(
                            item.lastBuyPrice +
                            item.processing_fee + 
                            ((item.salePrice * item.digip_profit_percentage)/100) + 
                            ((((item.salePrice * item.digip_profit_percentage)/100) + item.processing_fee) * 0.1) + 
                            (item.salePrice * 0.03)
                            ).toLocaleString()
                            : 0 %>
                        </td> 
                        <td style="background-color: rgb(152, 134, 255);"><%= item.buy_price_list ? parseInt(
                            item.buy_price_list + 
                            item.processing_fee + 
                            ((item.salePrice * item.digip_profit_percentage)/100) +
                            (((item.salePrice * item.digip_profit_percentage)/100 + item.processing_fee) * 0.1)  +
                            (item.salePrice*0.03)
                            ).toLocaleString() 
                            : 0 %></td> 
                        <!-- <td style="background-color: rgb(152, 134, 255);"><%= item.buy_price_list ? parseInt(item.buy_price_list+item.processing_fee+((item.salePrice*item.digip_profit_percentage)/100)).toLocaleString() : 0 %></td> -->
                        <!-- <td style="background-color: rgb(219, 245, 159);"><%= (item.salePrice-((item.salePrice * 25)/100)).toLocaleString() %></td> -->
                        
                        
                        <!-- <td style="background-color: rgb(255, 133, 133);"><%= item.marjae %></td> -->
                        <!-- marjae -->
                        
                        <% if(item.marjae < item.minSalePrice){ %>
                                <td id="currentMarjae" style="background-color: rgb(255, 65, 65);"><%= item.marjae.toLocaleString() %></td>
                        <%} else {%>
                                <td id="currentMarjae" style="background-color: rgb(255, 133, 133);"><%= item.marjae.toLocaleString() %></td>
                        <%}%>
                        
                        <!-- <td style="background-color: rgb(255, 189, 227);"><%= item.fulfilment_and_delivery_cost ? item.fulfilment_and_delivery_cost.toLocaleString() : 0%></td>
                        <td style="background-color: rgb(255, 189, 227);"><%= ((item.salePrice*10)/100).toLocaleString() %></td> -->

                        
                        <!-- <td style="background-color: rgb(255, 212, 133);"><%= ((item.salePrice-((item.salePrice*20)/100))-Math.ceil(item.lastBuyPrice)).toLocaleString() %></td>
                        <td style="background-color: rgb(255, 212, 133);"><%= (Math.ceil((((item.salePrice-((item.salePrice*20)/100))-Math.ceil(item.lastBuyPrice))*100)/item.lastBuyPrice)).toLocaleString() %></td> -->
                        <!-- <td style="background-color: rgb(255, 212, 133);"><%=  item.benefit ? item.benefit.toLocaleString() : 0 %></td> -->
                        <!-- <td style="background-color: rgb(255, 212, 133);"><%=  item.benefitPercent ? item.benefitPercent.toLocaleString() : 0 %></td> -->

                        <!-- <td style="background-color: rgb(255, 212, 133);"><%= Math.ceil(item.salePrice-((item.salePrice * 25)/100)-item.lastBuyPrice) %></td> -->
                        <!-- <td style="background-color: rgb(255, 212, 133);"><%= Math.ceil(((item.salePrice-((item.salePrice * 25)/100)-item.lastBuyPrice)*100)/(item.salePrice-((item.salePrice * 25)/100))) %></td> -->
                        <!-- <td><%= item.sumBackOfSale %></td> -->
                        <% if( item.stock >= 3) {%>
                            <td style="background-color: rgb(173, 255, 173);font-weight: 700;"><%= item.stock %></td>
                            <% } else { %>
                            <td style="background-color: rgb(99, 223, 99);font-weight: 700;"><%= item.stock %></td>
                        <% } %>
                        
                        <!-- <td><%= item.active?"فعال": "-" %></td> -->
                        
                            <% if(item.active){ %>
                                <% if (item.stock > 0 ){ %>
                                    <td> فعال</td>
                                <% } else {%>
                                    <td style='background-color:rgb(255, 196, 196);'> فعال </td>
                                <% } %>
                            <% } else{ %>
                                <%notActive+=1%>
                                <% if (item.stock > 0 ) {%>
                                    <td style='background-color:rgb(255, 196, 196);'> - </td>
                                <% } else {%>
                                        <td> - </td>
                                <%}%>
                            <%}%>
                        
                        <!-- <td><%= item.sumOfflineSale %></td> -->
                        <!-- <td><%= item.broken %></td> -->
                        <td style="color: red;"><%= item.stockDigiSite.toLocaleString() %></td>


                        <!-- قابل فروش -->
                        <!-- <% if(item.selling_stock === 0 && item.stock > 0) {%>
                            <td id="buyBox" style="background-color: rgb(255, 166, 0);"><%= item.selling_stock %></td>
                        <% } else {%>
                            <td id="buyBox" style="background-color: rgb(255, 166, 0);"><%= item.selling_stock %></td>
                        <% } %> -->


                        <!-- <td style="background-color: rgb(255, 0, 0); color: white;font-weight: 700;"><%= item.deffrenceDigi_Anbar %></td> -->
                        <% if(item.deffrenceDigi_Anbar === 0) {%>
                                <td ><%= item.deffrenceDigi_Anbar %></td>
                                <!-- <td style="background-color: rgb(255, 255, 255);"><%= item.deffrenceDigi_Anbar %></td> -->
                        <% } else if(item.deffrenceDigi_Anbar < 0 ){%>
                                <td style="background-color: rgb(255, 0, 0); color: white;font-weight: 700;"><%= item.deffrenceDigi_Anbar.toLocaleString() %></td>
                                <%less+=1%>
                        <% } else if(item.deffrenceDigi_Anbar > 0 ){%>
                            <td style="background-color: rgb(0, 174, 255); color: white;font-weight: 700;"><%= item.deffrenceDigi_Anbar.toLocaleString() %></td>
                            <%more+=1%>
                        <% }%>

                        <!-- بای باکس -->
                        <!-- <% if(!item.isBuyBox && item.buyBox && item.stock !==0) {%>
                            <td style="background-color: rgb(255, 212, 212);"><%= Number(item.buyBox).toLocaleString() %></td>
                            <%notBuyBox++%>
                        <% } else {%>
                                <td style="background-color: rgb(255, 255, 255);"><%= Number(item.buyBox).toLocaleString() %></td>
                        <%}%> -->



                        <!-- کاهش هوشمند -->
                        <!-- <% if(item.is_in_buy_box_challenge === true) {%>
                            <td id="buyBox" style="background-color: rgb(255, 238, 212);">ک‌هـ</td>
                        <% } else {%>
                                <td id="buyBox" style="background-color: rgb(255, 255, 255);">-</td>
                        <% } %> -->


                        <td style="background-color: rgb(255, 255, 255);"><%= item.description %></td>

                    </tr>
                    <% } %>
                    <% }) %>
                    <!-- <tr style="background-color: red;font-size: 20px; font-weight: 700;"><td>محصولات مشکل دار aaa<td><%=less%></td></tr> -->
                </table>
                <h2 style="background-color: rgb(255, 198, 198);font-size: 20px; font-weight: 700;padding: 20px;">در سایت دیجی بیشتر از موجودی انبار : <%=less%></h2>
                <h2 style="background-color: rgb(198, 227, 255);font-size: 20px; font-weight: 700;padding: 20px;">در سایت دیجی کمتر از موجودی انبار : <%=more%></h2>
                <h2 style="background-color: rgb(224, 224, 224);font-size: 20px; font-weight: 700;padding: 20px;">غیرفعال : <%=notActive%></h2>
                <h2 style="background-color: rgb(255, 202, 228);font-size: 20px; font-weight: 700;padding: 20px;">بدون بای باکس : <%=notBuyBox%>
                <h2 style="background-color: rgb(255, 96, 96);font-size: 20px; font-weight: 700;padding: 20px;">کمتر از حداقل قیمت - غیر فعال : <%=lessThanMinPriceNotActive%></h2>
                <h2 style="background-color: rgb(255, 0, 0);font-size: 20px; font-weight: 700;padding: 20px;">کمتر از حداقل قیمت - فعال : <%=lessThanMinPriceActive%></h2>

            </div>
            <% console.log('less =', less) %>
            <% console.log('more =', more) %>
        </div>
        <script src="script.js"></script>

    </body>

</html>